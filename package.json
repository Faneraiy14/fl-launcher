{
  "name": "fl-launcher",
  "version": "1.6.0",
  "description": "FL Launcher - сучасний лаунчер для Minecraft",
  "author": "Faneraiy14",
  "main": "src/main/index.js",
  "scripts": {
    "start": "chcp 65001 > nul && electron .",
    "kill": "taskkill /F /IM electron.exe 2>nul & taskkill /F /IM fl-launcher.exe 2>nul & exit 0",
    "clean": "if exist dist rmdir /s /q dist 2>nul & exit 0",
    "pre-release": "npm run kill && npm run clean",
    "dist": "electron-builder",
    "release": "npm run pre-release && electron-builder --publish always"
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "axios": "^1.17.0",
    "electron-updater": "^6.8.3",
    "minecraft-launcher-core": "^3.18.2",
    "tomate-loaders": "^2.0.2"
  },
  "devDependencies": {
    "electron": "41.3.0",
    "electron-builder": "^26.8.1"
  }
}
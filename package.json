{
  "name": "fl-launcher",
  "version": "1.0.1",
  "main": "src/main/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Faneraiy14/fl-launcher.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "taskkill /f /fi \"STATUS eq RUNNING\" /im fl-launcher.exe /im java.exe /im javaw.exe /im electron.exe && rmdir /s /q dist && electron-builder",
    "release": "taskkill /f /fi \"STATUS eq RUNNING\" /im fl-launcher.exe /im java.exe /im javaw.exe /im electron.exe && rmdir /s /q dist && electron-builder --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "minecraft-launcher-core": "^3.0.0"
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^26.8.1",
    "rimraf": "^5.0.10"
  },
  "build": {
    "appId": "com.fllauncher.app",
    "productName": "fl-launcher",
    "publish": [
      {
        "provider": "github",
        "owner": "Faneraiy14",
        "repo": "fl-launcher"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "directories": {
      "output": "dist"
    },
    "extraFiles": [
      {
        "from": "java",
        "to": "java",
        "filter": [
          "**/*"
        ]
      }
    ],
    "npmRebuild": false
  }
}
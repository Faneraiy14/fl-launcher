{
  "name": "my-mc-launcher",
  "version": "1.0.0",
  "main": "src/main/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Faneraiy14/First_Work_Minecraft_launcher.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "rimraf dist && electron-builder",
    "release": "rimraf dist && electron-builder --publish always"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "electron-updater": "^6.8.3",
    "minecraft-launcher-core": "^3.0.0"
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^26.8.1",
    "rimraf": "^5.0.10"
  },
  "build": {
    "appId": "com.mymclauncher.app",
    "productName": "MyMCLauncher",
    "publish": [
      {
        "provider": "github",
        "owner": "Faneraiy14",
        "repo": "First-Work-Minecraft-Launcher"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "directories": {
      "output": "dist"
    },
    "extraFiles": [
      {
        "from": "java",
        "to": "java",
        "filter": [
          "**/*"
        ]
      }
    ],
    "npmRebuild": false
  }
}
